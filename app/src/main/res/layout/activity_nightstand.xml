<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nightstandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Clock + photo take remaining space; ad strip is fixed-height below -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/godImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/nightstand_god_image"
                android:scaleType="fitCenter" />

            <View
                android:id="@+id/imageScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <!-- Every item in this column shares one centre line (center_horizontal),
                 so the time, date, status and Exit button line up on the same axis.
                 The clock takes the leftover height and auto-shrinks, so on short
                 phones the date, status and Exit button are never pushed off screen.
                 Other sizes come from values/-h340dp/-h380dp nightstand_dimens.xml. -->
            <TextView
                android:id="@+id/clockText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/cream"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/ns_clock_max"
                app:autoSizeMinTextSize="28sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ns_date_margin"
                android:gravity="center"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/cream"
                android:textSize="@dimen/ns_date_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chargingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ns_status_margin"
                android:gravity="center"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/brand"
                android:textSize="@dimen/ns_status_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mantraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ns_label_margin"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/cream"
                android:textSize="@dimen/ns_label_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sleepRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ns_label_margin"
                android:gravity="center"
                android:maxLines="1"
                android:textAlignment="center"
                android:textColor="@color/cream"
                android:textSize="@dimen/ns_label_size"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ns_exit_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ns_exit_margin"
                android:background="@drawable/btn_outline_bg"
                android:minWidth="@dimen/ns_exit_min_width"
                android:minHeight="0dp"
                android:paddingHorizontal="@dimen/ns_exit_pad"
                android:paddingVertical="0dp"
                android:text="@string/exit"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:textSize="@dimen/ns_exit_text"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adSection"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:background="@drawable/nightstand_ad_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp">

        <FrameLayout
            android:id="@+id/adPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/adPlaceholderImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.35"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/ad_advertisement"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
